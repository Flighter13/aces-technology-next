---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContentCard from '../components/ContentCard.astro';

const entries = await getCollection('presentations', ({ data }) => !data.draft);
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Presentations" description="Presentations and talks from ACES Technology.">
  <section class="page-shell">
    <h1>Presentations</h1>
    <p>The team regularly shares its approach to responsible autonomy, operational systems, and aerospace innovation.</p>
    <div class="grid">
      {entries.map((entry) => (
        <ContentCard
          title={entry.data.title}
          description={entry.data.description}
          href={`/presentations/${entry.id}`}
          meta={`${entry.data.venue ?? 'Conference'} • ${entry.data.link ? 'Slide link available' : 'Summary available'}`}
        />
      ))}
    </div>
  </section>
</Layout>
