---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContentCard from '../components/ContentCard.astro';

const entries = await getCollection('news', ({ data }) => !data.draft);
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="News" description="Recent news and project updates from ACES Technology.">
  <section class="page-shell">
    <h1>News</h1>
    <p>Updates on milestones, projects, and team activity are shared here as the work progresses.</p>
    <div class="grid">
      {entries.map((entry) => (
        <ContentCard
          title={entry.data.title}
          description={entry.data.description}
          href={`/news/${entry.id}`}
          meta={`${entry.data.category ?? 'Update'} • ${entry.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`}
        />
      ))}
    </div>
  </section>
</Layout>
