---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = (await getCollection('projects')).filter(({ data }) => data.featured).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Independent engineering research</p>
      <h1>Building adaptable systems for a world of changing sensors.</h1>
      <p class="lede">ACES Technology develops modular embedded-system prototypes at the intersection of sensing, autonomy, and open architecture.</p>
      <div class="actions"><a class="button primary" href="/projects/">Explore the work</a><a class="button" href="/about/">About the researcher</a></div>
    </div>
    <div class="system-map" aria-label="System architecture: sense, connect, understand">
      <p>MODULAR SYSTEM / 01</p>
      <div class="map-node"><span>01</span><strong>Sense</strong><small>Radar · LiDAR · GNSS</small></div>
      <div class="map-line"></div>
      <div class="map-node offset"><span>02</span><strong>Connect</strong><small>Open interfaces · Radio</small></div>
      <div class="map-line"></div>
      <div class="map-node"><span>03</span><strong>Understand</strong><small>Fusion · Interface · Action</small></div>
    </div>
  </section>

  <section class="statement">
    <p class="eyebrow">Mission</p>
    <h2>Turn experimental hardware into clear, testable engineering evidence.</h2>
    <p>The work pairs hands-on prototyping with disciplined architecture, documentation, and verification—connecting small-scale demonstrations to real aerospace and defense engineering questions.</p>
  </section>

  <section class="section-block">
    <div class="section-heading"><div><p class="eyebrow">Featured program</p><h2>Selected work</h2></div><a href="/projects/">View all →</a></div>
    <div class="project-grid">
      {projects.map(({ id, data }) => <a class="project-card" href={`/projects/${id}/`}>
        <div class="card-top"><span>{data.status}</span><span>{data.year}</span></div>
        <h3>{data.title}</h3><p>{data.summary}</p>
        <ul>{data.disciplines.slice(0,3).map(d => <li>{d}</li>)}</ul>
      </a>)}
      <a class="project-card quiet" href="/research/"><div class="card-top"><span>Research library</span><span>02</span></div><h3>Technical writing & analysis</h3><p>Architecture studies, program analysis, design briefs, and engineering documentation.</p><span class="card-link">Browse research →</span></a>
    </div>
  </section>
</BaseLayout>
