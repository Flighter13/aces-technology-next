---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const { title = 'ACES Technology', description = 'Applied aerospace innovation and responsible technology development.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = `${title} | ACES Technology`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ACES Technology" />
    <meta name="theme-color" content="#103a63" />
    <title>{pageTitle}</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <SiteHeader />
    <slot />
  </body>
</html>
