---
const current = Astro.url.pathname;
const links = [
  ['Work', '/projects/'],
  ['Research', '/research/'],
  ['Platforms', '/platforms/'],
  ['About', '/about/'],
  ['Contact', '/contact/'],
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label="ACES Technology home">
    <span class="brand-mark" aria-hidden="true">A</span>
    <span><strong>ACES</strong><small>Technology</small></span>
  </a>
  <button class="mobile-menu-button" type="button" aria-controls="primary-links" aria-expanded="false" onclick="const nav=document.getElementById('primary-links');const open=this.getAttribute('aria-expanded')!=='true';this.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open)">Menu</button>
  <nav id="primary-links" aria-label="Primary navigation">
    {links.map(([label, href]) => <a class:list={{ active: current.startsWith(href) }} href={href}>{label}</a>)}
  </nav>
</header>
