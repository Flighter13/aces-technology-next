---
const base = import.meta.env.BASE_URL;
const navItems = [
  { label: 'Home', href: base },
  { label: 'Research', href: `${base}research/` },
  { label: 'Profiles', href: `${base}profiles/` },
  { label: 'Publications', href: `${base}publications/` },
  { label: 'Presentations', href: `${base}presentations/` },
  { label: 'News', href: `${base}news/` },
  { label: 'About', href: `${base}about/` },
];
---

<header class="site-header">
  <a class="brand" href={base}>ACES Technology</a>
  <nav aria-label="Primary navigation">
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #d9e2ec;
    background: #f8fbff;
    gap: 1rem;
  }

  .brand {
    font-weight: 700;
    color: #103a63;
    text-decoration: none;
    font-size: 1.1rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: #214f7b;
    text-decoration: none;
    font-weight: 600;
  }

  nav a:hover,
  nav a:focus-visible {
    color: #0f6bbf;
  }

  @media (max-width: 768px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    nav ul {
      gap: 0.75rem;
    }
  }
</style>
